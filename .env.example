# Copy this file to .env (API and tooling) and to apps/web/.env.local (frontend).
# Never commit real values. .env* is gitignored, except this example file.

# ---- Supabase local stack (values from: npx supabase status -o env) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Private signing key file (JWK array). Read only by the admin token issuer. Mounted by the secret store in production.
SUPABASE_SIGNING_KEYS_PATH=../../supabase/signing_keys.json
# Storage verifies HS256 only. This secret mints 15-minute Storage service tokens on the server. Never sent to clients.
SUPABASE_STORAGE_SIGNING_SECRET=
# Optional legacy HS256 secret. Leave EMPTY: user tokens are ES256 and verified through the JWKS endpoint.
SUPABASE_JWT_SECRET=

# ---- Database ----
# Owner role. Used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_WITH_LOCAL_OWNER_PASSWORD@127.0.0.1:54322/postgres
# Password for the runtime role app_api. Letters, digits, '_' and '-' only, at least 24 characters.
APP_API_DB_PASSWORD=
# Runtime connection (RLS enforced). Must use the same password as APP_API_DB_PASSWORD.
DATABASE_URL=postgresql+psycopg://app_api:REPLACE_WITH_APP_API_DB_PASSWORD@127.0.0.1:54322/postgres

# ---- API ----
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Frontend (public values, safe to ship to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
